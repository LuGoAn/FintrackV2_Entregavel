<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="450.0" prefWidth="520.0" spacing="12.0" stylesheets="@estilo.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.TelaRelatorioController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>
    <Label styleClass="titulo" text="Relatório Financeiro" />
    <GridPane hgap="12.0" vgap="8.0">
        <Label text="Total de Receitas:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <Label fx:id="lblTotalReceitas" text="R$ 0,00" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Total de Despesas:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <Label fx:id="lblTotalDespesas" text="R$ 0,00" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Saldo Final:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <Label fx:id="lblSaldoLiquido" text="R$ 0,00" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label text="Total de Lançamentos:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <Label fx:id="lblTotalLancamentos" text="0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
    </GridPane>
    <Label text="Detalhamento das Operações:" />
    <TextArea fx:id="txtDetalhamento" editable="false" prefHeight="200.0" wrapText="true" VBox.vgrow="ALWAYS" />
    <HBox alignment="CENTER_RIGHT">
        <Button fx:id="btnFechar" onAction="#handleFechar" text="Fechar" />
    </HBox>
</VBox>
