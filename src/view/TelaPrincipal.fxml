<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="500.0" prefWidth="740.0" stylesheets="@estilo.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.TelaPrincipalController">
    <top>
        <VBox spacing="8.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="12.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="20.0">
                <VBox HBox.hgrow="ALWAYS">
                    <Label styleClass="titulo" text="FinTrack - Controle Financeiro" />
                    <Label styleClass="subtitulo" text="Gerenciador de finanças pessoais" />
                </VBox>
                <HBox alignment="CENTER_RIGHT" spacing="8.0">
                    <Label text="Saldo Atual:" />
                    <Label fx:id="lblSaldo" text="R$ 0,00" />
                </HBox>
            </HBox>
        </VBox>
    </top>
    <center>
        <TableView fx:id="tabelaTransacoes" prefHeight="340.0" prefWidth="710.0" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="colData" prefWidth="100.0" text="Data" />
                <TableColumn fx:id="colDescricao" prefWidth="300.0" text="Descrição" />
                <TableColumn fx:id="colTipo" prefWidth="110.0" text="Tipo" />
                <TableColumn fx:id="colValor" prefWidth="120.0" text="Valor" />
            </columns>
            <BorderPane.margin>
                <Insets left="15.0" right="15.0" />
            </BorderPane.margin>
        </TableView>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="12.0" />
            </padding>
            <Button fx:id="btnAtualizar" onAction="#handleAtualizar" text="Atualizar" />
            <Button fx:id="btnRelatorio" onAction="#handleRelatorio" text="Ver Relatório" />
            <Button fx:id="btnRemover" onAction="#handleRemover" text="Remover" />
            <Button fx:id="btnNova" onAction="#handleNovaTransacao" text="Nova Transação" />
        </HBox>
    </bottom>
</BorderPane>
